#test s21_is_less_15
s21_decimal decimal_1, decimal_2;

unsigned int mantissa_1[3] = {0x00000001, 0x00000000, 0x00000000};
set_decimal(&decimal_1, 0x1, 0x0, mantissa_1); // -1.0

unsigned int mantissa_2[3] = {0x00000001, 0x00000000, 0x00000000};
set_decimal(&decimal_2, 0x0, 0x0, mantissa_2); // 1.0

ck_assert_int_eq(s21_is_less(decimal_1, decimal_2), 1);

#test s21_is_less_16
s21_decimal decimal_1, decimal_2;

unsigned int mantissa_1[3] = {0x00000002, 0x00000000, 0x00000000};
set_decimal(&decimal_1, 0x1, 0x0, mantissa_1); // -2.0

unsigned int mantissa_2[3] = {0x00000001, 0x00000000, 0x00000000};
set_decimal(&decimal_2, 0x0, 0x0, mantissa_2); // 1.0

ck_assert_int_eq(s21_is_less(decimal_1, decimal_2), 1);

// ###################################################№#### s21_is_greater #######################################################

#test s21_is_greater_1
s21_decimal decimal_1, decimal_2;

unsigned int mantissa_1[3] = {0x00000001, 0x00000000, 0x00000000};
set_decimal(&decimal_1, 0x0, 0x0, mantissa_1); // 1.0

unsigned int mantissa_2[3] = {0x00000001, 0x00000000, 0x00000000};
set_decimal(&decimal_2, 0x1, 0x0, mantissa_2); // -1.0

ck_assert_int_eq(s21_is_greater(decimal_1, decimal_2), 1); // 1.0 > -1.0

#test s21_is_greater_2
s21_decimal decimal_1, decimal_2;

unsigned int mantissa_1[3] = {0x0000000A, 0x00000000, 0x00000000};
set_decimal(&decimal_1, 0x0, 0x0, mantissa_1); // 10.0

unsigned int mantissa_2[3] = {0x00000001, 0x00000000, 0x00000000};
set_decimal(&decimal_2, 0x0, 0x0, mantissa_2); // 1.0

ck_assert_int_eq(s21_is_greater(decimal_1, decimal_2), 1); // 10.0 > 1.0

