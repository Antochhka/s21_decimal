s21_decimal decimal2 = {{0x0, 0x10000000, 0x0, 0x0}};
s21_decimal result;
ck_assert_int_eq(s21_div(decimal1, decimal2, &result), 0);
// 0.0000000000000000000000000065
ck_assert_uint_eq(result.bits[0], 0x41);
ck_assert_uint_eq(result.bits[1], 0x0);
ck_assert_uint_eq(result.bits[2], 0x0);
