#test div_test_ok_15
// -26409387504754779197847983445
s21_decimal decimal1 = {{0x55555555, 0x55555555, 0x55555555, 0x80000000}};
// -429496729.5
s21_decimal decimal2 = {{0xFFFFFFFF, 0x0, 0x0, 0x80010000}};
s21_decimal result;
ck_assert_int_eq(s21_div(decimal1, decimal2, &result), 0);
// 61489146926681729710
ck_assert_uint_eq(result.bits[0], 0xAAAAAAAE);
ck_assert_uint_eq(result.bits[1], 0x55555558);
ck_assert_uint_eq(result.bits[2], 0x3);
ck_assert_uint_eq(result.bits[3], 0x0);

#test div_test_ok_16
// -79228162514264337593543950335
s21_decimal decimal1 = {{0xFFFFFFFF, 0xFFFFFFFF, 0xFFFFFFFF, 0x80000000}};
// 1.0000000000000000000000000001
s21_decimal decimal2 = {{0x10000001, 0x3E250261, 0x204FCE5E, 0x1C0000}};
s21_decimal result;
ck_assert_int_eq(s21_div(decimal1, decimal2, &result), 0);
// -79228162514264337593543950327
ck_assert_uint_eq(result.bits[0], 0xFFFFFFF7);
ck_assert_uint_eq(result.bits[1], 0xFFFFFFFF);
ck_assert_uint_eq(result.bits[2], 0xFFFFFFFF);
ck_assert_uint_eq(result.bits[3], 0x80000000);

#test div_test_ok_17
// 3.6336660283201536
s21_decimal decimal1 = {{0x811800, 0x811800, 0x0, 0x100000}};
// 0.0000000000000000000000000001
s21_decimal decimal2 = {{0x1, 0x0, 0x0, 0x1C0000}};
s21_decimal result;
ck_assert_int_eq(s21_div(decimal1, decimal2, &result), 0);
// 36336660283201536000000000000
ck_assert_uint_eq(result.bits[0], 0x89800000);
ck_assert_uint_eq(result.bits[1], 0xFEE8FB1C);
ck_assert_uint_eq(result.bits[2], 0x7568FB1C);
ck_assert_uint_eq(result.bits[3], 0x0);

