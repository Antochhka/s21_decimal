// ############################################################# ADD #############################################################

#test add_positive_numbers_1
s21_decimal decimal1 = {{0xFFFFFFFF, 0xFFFFFFFF, 0xFFFFFFFF, 0x140000}};
s21_decimal decimal2 = {{0xFFFFFFFF, 0xFFFFFFFF, 0xFFFFFFFF, 0x140000}};
ck_assert_int_eq(s21_add(decimal1, decimal2, NULL), 4);

#test add_positive_numbers_2
s21_decimal decimal1 = {{0x1, 0x0, 0x0, 0x0}}; // 1
s21_decimal decimal2 = {{0x1, 0x0, 0x0, 0x0}}; // 1
s21_decimal result;
ck_assert_int_eq(s21_add(decimal1, decimal2, &result), 0);
ck_assert_uint_eq(result.bits[0], 0x2);
ck_assert_uint_eq(result.bits[3], 0x0);

#test add_negative_numbers_3
s21_decimal decimal1 = {{0x1, 0x0, 0x0, 0x80000000}}; // -1
s21_decimal decimal2 = {{0x1, 0x0, 0x0, 0x80000000}}; // -1
s21_decimal result;
ck_assert_int_eq(s21_add(decimal1, decimal2, &result), 0);
ck_assert_uint_eq(result.bits[0], 0x2);
ck_assert_uint_eq(result.bits[3], 0x80000000);

#test add_positive_and_negative_4
s21_decimal decimal1 = {{0x1, 0x0, 0x0, 0x0}}; // 1
s21_decimal decimal2 = {{0x1, 0x0, 0x0, 0x80000000}}; // -1
s21_decimal result;
ck_assert_int_eq(s21_add(decimal1, decimal2, &result), 0);
ck_assert_uint_eq(result.bits[0], 0x0); 
ck_assert_uint_eq(result.bits[3], 0x0); 

#test add_overflow_5
s21_decimal decimal1 = {{0xFFFFFFFF, 0xFFFFFFFF, 0xFFFFFFFF, 0x0}};
s21_decimal decimal2 = {{0x1, 0x0, 0x0, 0x0}}; // 1
s21_decimal result;
ck_assert_int_eq(s21_add(decimal1, decimal2, &result), 1);

#test add_zero_6
s21_decimal decimal1 = {{0x0, 0x0, 0x0, 0x0}}; // 0
s21_decimal decimal2 = {{0x1, 0x0, 0x0, 0x0}}; // 1
s21_decimal result;
ck_assert_int_eq(s21_add(decimal1, decimal2, &result), 0); 
ck_assert_uint_eq(result.bits[0], 0x1);

#test add_different_scales_7
s21_decimal decimal1 = {{0x1, 0x0, 0x0, 0x10000}};
s21_decimal decimal2 = {{0x1, 0x0, 0x0, 0x20000}};
s21_decimal result;
ck_assert_int_eq(s21_add(decimal1, decimal2, &result), 0);
ck_assert_uint_eq(result.bits[0], 0xB);
ck_assert_uint_eq(result.bits[3], 0x20000);

#test add_max_scale_8
s21_decimal decimal1 = {{0x1, 0x0, 0x0, 0x1C0000}};
s21_decimal decimal2 = {{0x1, 0x0, 0x0, 0x1C0000}};
s21_decimal result;
ck_assert_int_eq(s21_add(decimal1, decimal2, &result), 0);
ck_assert_uint_eq(result.bits[0], 0x2);
ck_assert_uint_eq(result.bits[3], 0x1C0000); 

#test add_null_result_9
s21_decimal decimal1 = {{0x1, 0x0, 0x0, 0x0}}; // 1
s21_decimal decimal2 = {{0x1, 0x0, 0x0, 0x0}}; // 1
ck_assert_int_eq(s21_add(decimal1, decimal2, NULL), 4); 

#test add_large_scale_adjustment_10
s21_decimal a = {{12345, 0, 0, 0x50000}};
s21_decimal b = {{1234, 0, 0, 0x40000}};
s21_decimal result;
ck_assert_int_eq(s21_add(a, b, &result), 0);
ck_assert_uint_eq(result.bits[0], 12345 + 12340);
ck_assert_uint_eq(result.bits[3], 0x50000);



#test add_12
s21_decimal decimal1 = {{0xFFFFFFFF, 0xFFFFFFFF, 0xFFFFFFFF, 0x0}};
s21_decimal decimal2 = {{0x87FFFFFF, 0x1F128130, 0x1027E72F, 0x801C0000}};
s21_decimal result;
s21_decimal check = {{0xFFFFFFFF, 0xFFFFFFFF, 0xFFFFFFFF, 0x0}};
ck_assert_int_eq(s21_add(decimal1, decimal2, &result), 0);
ck_assert_int_eq(s21_is_equal(result,check), 1);

#test add_13
s21_decimal decimal1 = {{0xFFFFFFFF, 0xFFFFFFFF, 0xFFFFFFFF, 0x0}};
s21_decimal decimal2 = {{0x88000001, 0x1F128130, 0x1027E72F, 0x1C0000}};
s21_decimal result;
ck_assert_int_eq(s21_add(decimal1, decimal2, &result), 1);

#test add_14
s21_decimal decimal1 = {{0xFFFFFFFF, 0xFFFFFFFF, 0xFFFFFFFF, 0x0}};
s21_decimal decimal2 = {{0x1FFFFC18, 0x7C4A04C2, 0x409F9CBC, 0x1C0000}};
s21_decimal result;
ck_assert_int_eq(s21_add(decimal1, decimal2, &result), 1);

#test add_15
s21_decimal decimal1 = {{0, 0, 0, 1000000000}};
s21_decimal decimal2 = {{0xFFFFFFFF, 0xFFFFFFFF, 0xFFFFFFFF, 0x140000}};
s21_decimal result;
ck_assert_int_eq(s21_add(decimal1, decimal2, &result), 4);

#test add_16
s21_decimal decimal1 = {{-1, 0, 0, 0x1D0000}};
s21_decimal decimal2 = {{0xFFFFFFFF, 0xFFFFFFFF, 0xFFFFFFFF, 0x140000}};
s21_decimal result;
ck_assert_int_eq(s21_add(decimal1, decimal2, &result), 4);

#test add_17
s21_decimal decimal1 = {{0xFFFFFFFE, 0xFFFFFFFF, 0xFFFFFFFF, 0x80000000}};
s21_decimal decimal2 = {{0xFFFFFFFF, 0xFFFFFFFF, 0xFFFFFFFF, 0x0}};
s21_decimal result;
s21_decimal check = {{0x1, 0x0, 0x0, 0x0}};
ck_assert_int_eq(s21_add(decimal1, decimal2, &result), 0);
ck_assert_int_eq(s21_is_equal(result,check), 1);

#test add_18
s21_decimal decimal1 = {{0xFFFFFFFE, 0xFFFFFFFF, 0xFFFFFFFF, 0x0}};
s21_decimal decimal2 = {{0x122233EE, 0x5675EBE6, 0xD1C83484, 0x140000}};
s21_decimal result;
ck_assert_int_eq(s21_add(decimal1, decimal2, &result), 1);

#test add_diff_scales_signs_19
s21_decimal a = {{500, 0, 0, 0x20000}};
s21_decimal b = {{50, 0, 0, 0x80010000}}; 
s21_decimal result;
ck_assert_int_eq(s21_add(a, b, &result), 0);
ck_assert_uint_eq(result.bits[3], 0x20000);

#test add_rounding_20
s21_decimal a = {{9999999, 0, 0, 0x70000}}; 
s21_decimal b = {{1, 0, 0, 0x70000}}; 
s21_decimal result;
ck_assert_int_eq(s21_add(a, b, &result), 0);
ck_assert_uint_eq(result.bits[0], 10000000);
ck_assert_uint_eq(result.bits[3], 0x70000);

#test add_tiny_numbers_21
