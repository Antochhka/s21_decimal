// ################################################ s21_from_float_to_decimal ################################################

// Тест 1.1: Преобразование нуля
#test s21_from_float_to_decimal_zero_1

float f = 0.0;
s21_decimal result;
s21_decimal check = {{0x0, 0x0, 0x0, 0x0}};
int code = s21_from_float_to_decimal(f, &result);
ck_assert_int_eq(code, 0);
ck_assert_int_eq(s21_is_equal(result, check), 1);


// Тест 1.2: Преобразование нуля
#test s21_from_float_to_decimal_zero_2

float f = -0.0;
s21_decimal result;
s21_decimal check = {{0x0, 0x0, 0x0, 0x80000000}};
int code = s21_from_float_to_decimal(f, &result);
int sign_check = get_sign(check);
int sign_result = get_sign(result);
ck_assert_int_eq(code, 0);
ck_assert_int_eq(s21_is_equal(result, check), 1);
ck_assert_int_eq(sign_check, sign_result);


