// ############################################################# SUB #############################################################

#test sub_positive_numbers_1
s21_decimal a = {{0xFFFFFFFF, 0xFFFFFFFF, 0xFFFFFFFF, 0x140000}};
s21_decimal b = {{0xFFFFFFFF, 0xFFFFFFFF, 0xFFFFFFFF, 0x140000}};
s21_decimal result;
s21_decimal check = {{0x0, 0x0, 0x0, 0x140000}};
ck_assert_int_eq(s21_sub(a, b, &result), 0);
ck_assert_int_eq(s21_is_equal(result,check),1);

#test sub_positive_numbers_2
s21_decimal decimal1 = {{0x2, 0x0, 0x0, 0x0}}; // 2
s21_decimal decimal2 = {{0x1, 0x0, 0x0, 0x0}}; // 1
s21_decimal result;
ck_assert_int_eq(s21_sub(decimal1, decimal2, &result), 0);
ck_assert_uint_eq(result.bits[0], 0x1);
ck_assert_uint_eq(result.bits[3], 0x0);


#test sub_positive_and_negative_4
s21_decimal decimal1 = {{0x1, 0x0, 0x0, 0x0}}; // 1
s21_decimal decimal2 = {{0x1, 0x0, 0x0, 0x80000000}}; // -1
s21_decimal result;
ck_assert_int_eq(s21_sub(decimal1, decimal2, &result), 0);
ck_assert_uint_eq(result.bits[0], 0x2); 
ck_assert_uint_eq(result.bits[3], 0); 

#test sub_overflow_5
s21_decimal a = {{0x1, 0x0, 0x0, 0x10000}};
s21_decimal b = {{0x1, 0x0, 0x0, 0x20000}};
s21_decimal result;
s21_decimal check = {{0x9, 0x0, 0x0, 0x20000}};
ck_assert_int_eq(s21_sub(a, b, &result), 0);
ck_assert_int_eq(s21_is_equal(result,check),1);

#test sub_zero_6
s21_decimal decimal1 = {{0x0, 0x0, 0x0, 0x0}}; // 0
s21_decimal decimal2 = {{0x0, 0x0, 0x0, 0x0}}; // 0
s21_decimal result;
ck_assert_int_eq(s21_sub(decimal1, decimal2, &result), 0); 
ck_assert_uint_eq(result.bits[0], 0x0);

#test sub_null_result_7
s21_decimal decimal1 = {{0x1, 0x0, 0x0, 0x0}}; // 1
s21_decimal decimal2 = {{0x1 , 0x0, 0x0, 0x0}}; // 1
ck_assert_int_eq(s21_sub(decimal1, decimal2, NULL), 4);

#test sub_max_scale_8
s21_decimal decimal1 = {{0x2, 0x0, 0x0, 0x1C0000}};
s21_decimal decimal2 = {{0x1, 0x0, 0x0, 0x1C0000}};
s21_decimal result;
ck_assert_int_eq(s21_sub(decimal1, decimal2, &result), 0);
ck_assert_uint_eq(result.bits[0], 0x1);
ck_assert_uint_eq(result.bits[3], 0x1C0000); 

#test sub_large_scale_adjustment_9
s21_decimal a = {{12345, 0, 0, 0x50000}};
s21_decimal b = {{1234, 0, 0, 0x40000}};
s21_decimal result;
s21_decimal check = {{0x5, 0x0, 0x0, 0x50000}};
ck_assert_int_eq(s21_sub(a, b, &result), 0);
ck_assert_int_eq(s21_is_equal(result,check),1);

#test sub_negative_zero_10
s21_decimal decimal1 = {{0x0, 0x0, 0x0, 0x80000000}}; // -0
s21_decimal decimal2 = {{0x0, 0x0, 0x0, 0x0}}; // 0
s21_decimal result;
ck_assert_int_eq(s21_sub(decimal1, decimal2, &result), 0);
ck_assert_uint_eq(result.bits[0], 0x0);
ck_assert_uint_eq(result.bits[3], 0x80000000);

#test sub_large_numbers_11
s21_decimal decimal1 = {{0xFFFFFFFF, 0xFFFFFFFF, 0xFFFFFFFF, 0x0}};
s21_decimal decimal2 = {{0x1, 0x0, 0x0, 0x0}}; // 1
s21_decimal result;
ck_assert_int_eq(s21_sub(decimal1, decimal2, &result), 0);
ck_assert_uint_eq(result.bits[0], 0xFFFFFFFE);
ck_assert_uint_eq(result.bits[3], 0x0);

#test add_diff_scales_signs_12
s21_decimal a = {{500, 0, 0, 0x20000}};
s21_decimal b = {{50, 0, 0, 0x10000}}; 
s21_decimal result;
ck_assert_int_eq(s21_sub(a, b, &result), 0);
ck_assert_uint_eq(result.bits[3], 0x20000);

#test sub_rounding_max_scale_13
s21_decimal a = {{123456789, 0, 0, 0x80000}};
s21_decimal b= {{234567891, 0, 0, 0x80000}};
s21_decimal result;
s21_decimal check = {{0x69F6BBE, 0x0, 0x0, 0x80080000}};
ck_assert_int_eq(s21_sub(a, b, &result), 0);
ck_assert_int_eq(s21_is_equal(result, check), 1);

#test sub_zero_diff_scales_12
s21_decimal a = {{1005, 0, 0, 0x30000}};
s21_decimal b =  {{1005, 0, 0, 0x80020000}};
s21_decimal result;
s21_decimal check = {{0x2B2F, 0x0, 0x0, 0x30000}};
ck_assert_int_eq(s21_sub(a, b, &result), 0);
ck_assert_int_eq(s21_is_equal(result, check), 1);

#test sub_diff_sign_overflow_14
s21_decimal decimal1 = {{0xFFFFFFFE, 0xFFFFFFFF, 0xFFFFFFFF, 0x0}};
s21_decimal decimal2 = {{3, 0, 0, 0x80000000}};
s21_decimal result;
ck_assert_int_eq(s21_sub(decimal1, decimal2, &result), 1);

#test sub_large_scale_adjustment_15
s21_decimal a = {{12345, 0, 0, 0x50000}};
s21_decimal b = {{1234, 0, 0, 0x40000}};
s21_decimal result;
s21_decimal check = {{0x5, 0x0, 0x0, 0x50000}};
ck_assert_int_eq(s21_sub(a, b, &result), 0);
ck_assert_int_eq(s21_is_equal(result, check), 1);

#test sub_tiny_numbers_16
s21_decimal decimal1 = {{1, 0, 0, 0x1C0000}};
s21_decimal decimal2 = {{1, 0, 0, 0x1C0000}};
s21_decimal result;
ck_assert_int_eq(s21_sub(decimal1, decimal2, &result), 0);
ck_assert_uint_eq(result.bits[0], 0);
ck_assert_uint_eq(result.bits[3], 0x1C0000);

#test sub_overflow_after_scaling_17
s21_decimal decimal1 = {{0xFFFFFFFF, 0xFFFFFFFF, 0xFFFFFFFF, 0x0}};
s21_decimal decimal2 = {{1, 0, 0, 0x10000}};
s21_decimal result;
ck_assert_int_eq(s21_sub(decimal1, decimal2, &result), 0);
ck_assert_int_eq(s21_is_equal(result, decimal1), 1);

#test sub_rounding_18
s21_decimal decimal1 = {{9999999, 0, 0, 0x70000}};
s21_decimal decimal2 = {{1, 0, 0, 0x70000}};
s21_decimal result;
ck_assert_int_eq(s21_sub(decimal1, decimal2, &result), 0);
ck_assert_uint_eq(result.bits[0], 9999998);
ck_assert_uint_eq(result.bits[3], 0x70000);

#test sub_diff_sign_overflow_19
s21_decimal a = {{0xFFFFFFFE, 0xFFFFFFFF, 0xFFFFFFFF, 0x0}};
s21_decimal b = {{3, 0, 0, 0x80000000}};
s21_decimal result;
ck_assert_int_eq(s21_sub(a, b, &result), 1);

#test sub_diff_scales_signs_20
s21_decimal a = {{500, 0, 0, 0x20000}};
s21_decimal b = {{50, 0, 0, 0x80010000}}; 
s21_decimal result;
ck_assert_int_eq(s21_sub(a, b, &result), 0);
ck_assert_uint_eq(result.bits[3], 0x20000);

#test sub_rounding_21
s21_decimal a = {{9999999, 0, 0, 0x70000}}; 
s21_decimal b = {{1, 0, 0, 0x70000}}; 
s21_decimal result;
ck_assert_int_eq(s21_sub(a, b, &result), 0);
ck_assert_uint_eq(result.bits[0], 9999998);
ck_assert_uint_eq(result.bits[3], 0x70000);

#test sub_tiny_numbers_22
s21_decimal a = {{1, 0, 0, 0x1C0000}};
s21_decimal b = {{1, 0, 0, 0x1C0000}};
s21_decimal result;
ck_assert_int_eq(s21_sub(a, b, &result), 0);
ck_assert_uint_eq(result.bits[0], 0);
ck_assert_uint_eq(result.bits[3], 0x1C0000);

#test sub_overflow_after_scaling_23
s21_decimal a = {{0xFFFFFFFF, 0xFFFFFFFF, 0xFFFFFFFF, 0x0}};
s21_decimal b = {{1, 0, 0, 0x10000}};
s21_decimal result;
ck_assert_int_eq(s21_sub(a, b, &result), 0);
ck_assert_int_eq(s21_is_equal(result, a), 1);

#test sub_zero_diff_scales_24
s21_decimal a = {{1005, 0, 0, 0x30000}};
s21_decimal b = {{1005, 0, 0, 0x80020000}};
s21_decimal result;
s21_decimal check = {{0x2B2F, 0, 0, 0x30000}};
ck_assert_int_eq(s21_sub(a, b, &result), 0);
ck_assert_int_eq(s21_is_equal(result, check), 1);

#test sub_rounding_max_scale_25
s21_decimal a = {{123456789, 0, 0, 0x80000}};
s21_decimal b = {{234567891, 0, 0, 0x80000}};
s21_decimal result;
s21_decimal check = {{0x69F6BBE, 0, 0, 0x80080000}};
ck_assert_int_eq(s21_sub(a, b, &result), 0);
ck_assert_int_eq(s21_is_equal(result, check), 1);

#test sub_26
s21_decimal a = {{-1, 0, 0, 0x1D0000}};
s21_decimal b = {{0xFFFFFFFF, 0xFFFFFFFF, 0xFFFFFFFF, 0x140000}};
s21_decimal result;
ck_assert_int_eq(s21_sub(a, b, &result), 4);

#test sub_negate_27
s21_decimal a = {{0xFFFFFFFE, 0xFFFFFFFF, 0xFFFFFFFF, 0x0433345}};
s21_decimal b = {{0x1, 0x0, 0x0, 0x1C0000}};
s21_decimal result;
ck_assert_int_eq(s21_sub(a, b, &result), 4);

#test sub_negate_28
s21_decimal a = {{0xFFFFFFFE, 0xFFFFFFFF, 0xFFFFFFFF, 0x0}};
s21_decimal b = {{0x1, 0x0, 0x0, 0x1C10000}};
s21_decimal result;
ck_assert_int_eq(s21_sub(a, b, &result), 4);

#test sub_max_minus_min_29
s21_decimal a = {{0xFFFFFFFF, 0xFFFFFFFF, 0xFFFFFFFF, 0}};
s21_decimal b = {{0xFFFFFFFF, 0xFFFFFFFF, 0xFFFFFFFF, 0x80000000}};
s21_decimal result;
ck_assert_int_eq(s21_sub(a, b, &result), 1);

#test sub_extreme_scales_30
s21_decimal a = {{12345, 0, 0, 0x1C0000}};
s21_decimal b = {{1, 0, 0, 0}};
s21_decimal result;
s21_decimal check =  {{0xFFFCFC7, 0x3e250261, 0x204FCE5E,  0x801C0000}};
ck_assert_int_eq(s21_sub(a, b, &result), 0);
ck_assert_int_eq(s21_is_equal(result, check), 1);

#test sub_normalization_31
s21_decimal a = {{1500, 0, 0, 0x30000}};
s21_decimal b = {{500, 0, 0, 0x30000}};
s21_decimal result;
ck_assert_int_eq(s21_sub(a, b, &result), 0);
ck_assert_uint_eq(result.bits[0], 1000);
ck_assert_uint_eq((result.bits[3] >> 16) & 0xFF, 3);

#test sub_sign_flip_32
s21_decimal a = {{50, 0, 0, 0x80000000}};
s21_decimal b = {{100, 0, 0, 0}};
s21_decimal result;
ck_assert_int_eq(s21_sub(a, b, &result), 0);
ck_assert((result.bits[3] & 0x80000000) != 0);
ck_assert_uint_eq(result.bits[0], 150);

#test sub_invalid_scale_33
s21_decimal a = {{5, 0, 0, 0x1D0000}};
s21_decimal b = {{3, 0, 0, 0}};
s21_decimal result;
ck_assert_int_eq(s21_sub(a, b, &result), 4);

#test sub_carry_chain_34
s21_decimal a = {{0xFFFFFFFF, 0xFFFFFFFF, 0, 0}};
s21_decimal b = {{0x1, 0, 0, 0}};
s21_decimal result;
ck_assert_int_eq(s21_sub(a, b, &result), 0);
ck_assert_uint_eq(result.bits[0], 0xFFFFFFFE);
ck_assert_uint_eq(result.bits[1], 0xFFFFFFFF);
ck_assert_uint_eq(result.bits[2], 0);

#test sub_small_numbers_35
s21_decimal a = {{1, 0, 0, 0x1C0000}};
s21_decimal b = {{2, 0, 0, 0x1C0000}};
s21_decimal result;
ck_assert_int_eq(s21_sub(a, b, &result), 0);
ck_assert((result.bits[3] & 0x80000000) != 0);
ck_assert_uint_eq(result.bits[0], 1);

#test sub_scale_overflow_36
s21_decimal a = {{999999999, 0, 0, 0x1B0000}};
s21_decimal b = {{1, 0, 0, 0xE0000}};
s21_decimal result;
s21_decimal check =  {{0x12D7D601, 0x918, 0x0,  0x801B0000}};
ck_assert_int_eq(s21_sub(a, b, &result), 0);
ck_assert_int_eq(s21_is_equal(result, check), 1);

#test sub_unused_bits_37
s21_decimal a = {{5, 0, 0, 0xFF0000}};
s21_decimal b = {{3, 0, 0, 0}};
s21_decimal result;
ck_assert_int_eq(s21_sub(a, b, &result), 4);

#test sub_edge_negative_38
s21_decimal a = {{0xFFFFFFFF, 0xFFFFFFFF, 0xFFFFFFFF, 0x80000000}};
s21_decimal b = {{0xFFFFFFFF, 0xFFFFFFFF, 0xFFFFFFFF, 0}};
s21_decimal result;
ck_assert_int_eq(s21_sub(a, b, &result), 2);

#test sub_zero_normalization_39
s21_decimal a = {{0, 0, 0, 0x1C0000}};
s21_decimal b = {{0, 0, 0, 0x50000}};
s21_decimal result;
ck_assert_int_eq(s21_sub(a, b, &result), 0);
ck_assert_uint_eq(result.bits[3], 0x1C0000);

#test sub_underflow_40
s21_decimal a = {{0x1, 0x0, 0x0, 0x1C0000}};
s21_decimal b = {{0x2, 0x0, 0x0, 0x1C0000}};
s21_decimal result;
ck_assert_int_eq(s21_sub(a, b, &result), 0);
ck_assert((result.bits[3] & 0x80000000) != 0);

#test sub_41
s21_decimal a = {{0x87FFFFFF, 0x1F128130, 0x1027E72F, 0x801C0000}};
s21_decimal b = {{0x87FFFFFF, 0x1F128130, 0x1027E72F, 0x801C0000}};
s21_decimal check = {{0x0, 0x0, 0x0, 0x801C0000}};
s21_decimal result;
ck_assert_int_eq(s21_sub(a, b, &result), 0);
ck_assert_int_eq(s21_is_equal(result,check),1);

#test sub_42
s21_decimal a = {{0x87FFFFFF, 0x1F128130, 0x1027E72F, 0x801C0000}};
s21_decimal b = {{0x87FFFFFF, 0x1F128130, 0x1027E72E, 0x801C0000}};
s21_decimal check = {{0x0, 0x0, 0x1, 0x801C0000}};
s21_decimal result;
ck_assert_int_eq(s21_sub(a, b, &result), 0);
ck_assert_int_eq(s21_is_equal(result,check),1);

#test sub_43
s21_decimal a = {{0x87FFFFFF, 0x1F128130, 0x1027E72F, 0x801C0000}};
s21_decimal b = {{0xFFFFFFFF, 0xFFFFFFFF, 0xFFFFFFFF, 0x0}};
s21_decimal check = {{0xFFFFFFFF, 0xFFFFFFFF, 0xFFFFFFFF, 0x80000000}};
s21_decimal result;
ck_assert_int_eq(s21_sub(a, b, &result), 0);
ck_assert_int_eq(s21_is_equal(result,check),1);

// ############################################################# MUL #############################################################

#test mul_ok_simple_1
s21_decimal a = {{2, 0, 0, 0}};
s21_decimal b = {{3, 0, 0, 0}};
s21_decimal result;
ck_assert_int_eq(s21_mul(a, b, &result), 0);
ck_assert_uint_eq(result.bits[0], 6);
ck_assert_uint_eq(result.bits[1], 0);
ck_assert_uint_eq(result.bits[2], 0);
ck_assert_uint_eq(result.bits[3], 0);

#test mul_overflow_positive_2
s21_decimal max_val = {{0xFFFFFFFF, 0xFFFFFFFF, 0xFFFFFFFF, 0}};
s21_decimal two = {{2, 0, 0, 0}};
s21_decimal result;
ck_assert_int_eq(s21_mul(max_val, two, &result), 1);


#test mul_overflow_negative_3
s21_decimal min_val = {{0xFFFFFFFF, 0xFFFFFFFF, 0xFFFFFFFF, 0x80000000}};
s21_decimal two = {{2, 0, 0, 0}};
s21_decimal result;
ck_assert_int_eq(s21_mul(min_val, two, &result), 2);

#test mul_zero_4
s21_decimal a = {{123, 456, 789, 0x1C0000}}; // scale 28
s21_decimal zero = {{0, 0, 0, 0}};
s21_decimal result;
ck_assert_int_eq(s21_mul(a, zero, &result), 0);
ck_assert_uint_eq(result.bits[0], 0);
ck_assert_uint_eq(result.bits[1], 0);
ck_assert_uint_eq(result.bits[2], 0);
ck_assert_uint_eq(result.bits[3], 0);

#test mul_sign_negative_5
s21_decimal a = {{5, 0, 0, 0x80000000}};
s21_decimal b = {{3, 0, 0, 0}};
s21_decimal result;
s21_mul(a, b, &result);
ck_assert_uint_eq(result.bits[0], 15);
ck_assert((result.bits[3] & 0x80000000) != 0);
ck_assert((result.bits[3] & 0xFF0000) == 0);

#test mul_scale_addition_6
s21_decimal a = {{12345, 0, 0, 0x50000}}; // scale 5
s21_decimal b = {{67890, 0, 0, 0xA0000}}; // scale 10
s21_decimal result;
s21_mul(a, b, &result);
ck_assert(((result.bits[3] & 0xFF0000) >> 16) == 15);

#test mul_negative_negative_8
s21_decimal a = {{5, 0, 0, 0x80000000}}; // -5
s21_decimal b = {{3, 0, 0, 0x80000000}}; // -3
s21_decimal result;
ck_assert_int_eq(s21_mul(a, b, &result), 0);
ck_assert_uint_eq(result.bits[0], 15);
ck_assert((result.bits[3] & 0x80000000) == 0);
ck_assert((result.bits[3] & 0xFF0000) == 0);

#test mul_positive_negative_9
s21_decimal a = {{4, 0, 0, 0}}; // 4
s21_decimal b = {{2, 0, 0, 0x80000000}}; // -2
s21_decimal result;
ck_assert_int_eq(s21_mul(a, b, &result), 0);
ck_assert_uint_eq(result.bits[0], 8);
ck_assert((result.bits[3] & 0x80000000) != 0); 
ck_assert((result.bits[3] & 0xFF0000) == 0);

#test mul_max_zero_10
s21_decimal max_val = {{0xFFFFFFFF, 0xFFFFFFFF, 0xFFFFFFFF, 0}}; 
s21_decimal zero = {{0, 0, 0, 0}}; // Ноль
s21_decimal result;
ck_assert_int_eq(s21_mul(max_val, zero, &result), 0);
ck_assert_uint_eq(result.bits[0], 0);
ck_assert_uint_eq(result.bits[1], 0);
ck_assert_uint_eq(result.bits[2], 0);
ck_assert_uint_eq(result.bits[3], 0);

#test mul_overflow_rounding_11
s21_decimal i = {{0xFFFFFFFF, 0xFFFFFFFF, 0xFFFFFFFF, 0}}; 
s21_decimal j = {{3, 0, 0, 0}}; // 3
s21_decimal result;
ck_assert_int_eq(s21_mul(i, j, &result), 1);

#test mul_same_scale_12
s21_decimal a= {{100, 0, 0, 0x20000}};
s21_decimal b = {{200, 0, 0, 0x20000}};
s21_decimal result;
s21_decimal result2 = {{0x4E20, 0, 0, 0x40000}};
ck_assert_int_eq(s21_mul(a, b, &result), 0);
ck_assert_int_eq(s21_is_equal(result,result2), 1);

#test mul_different_scale_13
s21_decimal a = {{100, 0, 0, 0x20000}};
s21_decimal b = {{200, 0, 0, 0x30000}};
s21_decimal result;
s21_decimal result2 = {{0x4E20, 0, 0, 0x50000}};
ck_assert_int_eq(s21_mul(a, b, &result), 0);
ck_assert_int_eq(s21_mul(a, b, &result), 0);
ck_assert_int_eq(s21_is_equal(result,result2), 1);

#test mul_negate_14
s21_decimal a = {{0xFFFFFFFE, 0xFFFFFFFF, 0xFFFFFFFF, 0x0433345}};
s21_decimal b = {{0x1, 0x0, 0x0, 0x1C0000}};
s21_decimal result;
ck_assert_int_eq(s21_mul(a, b, &result), 4);

#test mul_negate_15
s21_decimal a = {{0xFFFFFFFE, 0xFFFFFFFF, 0xFFFFFFFF, 0x0}};
s21_decimal b = {{0x1, 0x0, 0x0, 0x1C10000}};
s21_decimal result;
ck_assert_int_eq(s21_mul(a, b, &result), 4);

#test mul_16
s21_decimal a = {{0x87FFFFFF, 0x1F128130, 0x1027E72F, 0x1C0000}};
s21_decimal b = {{0x2, 0x0, 0x0, 0x0000}};
s21_decimal check = {{0xFFFFFFE, 0x3e250261, 0x204FCE5E, 0x1C0000}};
s21_decimal result;
ck_assert_int_eq(s21_mul(a, b, &result), 0);
ck_assert_int_eq(s21_is_equal(result,check),1);

#test mul_max_scale_17
s21_decimal a = {{1, 0, 0, 0x1C0000}};
s21_decimal b = {{1, 0, 0, 0x1C0000}};
s21_decimal result;
ck_assert_int_eq(s21_mul(a, b, &result), 2);

#test mul_sum_scale_28_18
s21_decimal a = {{1, 0, 0, 0x140000}};
s21_decimal b = {{1, 0, 0, 0x80000}};
s21_decimal result;
ck_assert_int_eq(s21_mul(a, b, &result), 0);
ck_assert(((result.bits[3] & 0xFF0000) >> 16) == 28);

#test mul_rounding_loss_19
s21_decimal a = {{123456789, 0, 0, 0x1C0000}};
s21_decimal b = {{10, 0, 0, 0}};
s21_decimal result;
s21_decimal check = {{0x499602D2,0, 0, 0x1C0000}};
ck_assert_int_eq(s21_mul(a, b, &result), 0);
ck_assert_int_eq(s21_is_equal(result, check), 1);

#test mul_invalid_bits_20
s21_decimal a = {{5, 0, 0, 0x10000FF}};
s21_decimal b = {{3, 0, 0, 0}};
s21_decimal result;
ck_assert_int_eq(s21_mul(a, b, &result), 4);

#test mul_carry_over_21
s21_decimal a = {{0xFFFFFFFF, 0xFFFFFFFF, 0, 0}};
s21_decimal b = {{2, 0, 0, 0}};
s21_decimal result;
ck_assert_int_eq(s21_mul(a, b, &result), 0);
ck_assert_uint_eq(result.bits[0], 0xFFFFFFFE);
ck_assert_uint_eq(result.bits[1], 0xFFFFFFFF);
ck_assert_uint_eq(result.bits[2], 1);


#test mul_high_mantissa_23
s21_decimal a = {{0x12345678, 0xABCDEF01, 0x55AA55AA, 0x80000}};
s21_decimal b = {{2, 0, 0, 0x10000}};
s21_decimal result;
s21_decimal check = {{0x2468ACF0,0x579BDE02, 0xAB54AB55, 0x90000}};
ck_assert_int_eq(s21_mul(a, b, &result), 0);
ck_assert_int_eq(s21_is_equal(result, check), 1);

#test mul_fraction_rounding_24
s21_decimal a = {{12345, 0, 0, 0x50000}};
s21_decimal b = {{6789, 0, 0, 0x30000}};
s21_decimal result;
ck_assert_int_eq(s21_mul(a, b, &result), 0);
ck_assert(result.bits[0] == 83810205);
ck_assert(((result.bits[3] & 0xFF0000) >> 16) == 8);

#test mul_mantissa_overflow_25
s21_decimal a = {{0x80000000, 0, 0, 0}};
s21_decimal b = {{0x80000000, 0, 0, 0}};
s21_decimal result;
s21_decimal check = {{0x0,0x40000000, 0, 0x0000}};
ck_assert_int_eq(s21_mul(a, b, &result), 0);
ck_assert_int_eq(s21_is_equal(result, check), 1);

#test mul_null_result_26
s21_decimal a = {{5, 0, 0, 0}};
s21_decimal b = {{3, 0, 0, 0}};
ck_assert_int_eq(s21_mul(a, b, NULL), 4);

#test mul_mixed_sign_scale_27
s21_decimal a = {{123, 0, 0, 0x80000000 | 0x50000}};
s21_decimal b = {{456, 0, 0, 0x20000}};
s21_decimal result;
ck_assert_int_eq(s21_mul(a, b, &result), 0);
ck_assert(result.bits[0] == 56088);
ck_assert(((result.bits[3] & 0xFF0000) >> 16) == 7);
ck_assert((result.bits[3] & 0x80000000) != 0);

#test mul_large_scale_28
s21_decimal a = {{1, 0, 0, 0x1C0000}};
s21_decimal b = {{1, 0, 0, 0x10000}};
s21_decimal result;
ck_assert_int_eq(s21_mul(a, b, &result), 2);

#test mul_normalization_29
s21_decimal a = {{123000, 0, 0, 0x60000}};
s21_decimal b = {{1000, 0, 0, 0x30000}};
s21_decimal result;
s21_decimal check = {{0x754D4C0,0x0, 0x0, 0x90000}};
ck_assert_int_eq(s21_mul(a, b, &result), 0);
ck_assert_int_eq(s21_is_equal(result, check), 1);


#test mul_exact_max_scale_31
s21_decimal a = {{1200, 0, 0, 0x30000}};
s21_decimal b = {{3400, 0, 0, 0x30000}};
s21_decimal result;
s21_decimal check = {{0x3e4180,0x0, 0x0, 0x60000}};
ck_assert_int_eq(s21_mul(a, b, &result), 0);
ck_assert_int_eq(s21_is_equal(result, check), 1);

#test mul_trailing_zeros_32
s21_decimal a = {{1200, 0, 0, 0x30000}};
s21_decimal b = {{3400, 0, 0, 0x30000}};
s21_decimal result;
s21_decimal check = {{0x3e4180,0x0, 0x0, 0x60000}};
ck_assert_int_eq(s21_mul(a, b, &result), 0);
ck_assert_int_eq(s21_is_equal(result, check), 1);

#test mul_max_by_fraction_33
s21_decimal a = {{0xFFFFFFFF, 0xFFFFFFFF, 0xFFFFFFFF, 0}};
s21_decimal b = {{1, 0, 0, 0x10000}};
s21_decimal result;
s21_decimal check =  {{0xFFFFFFFF, 0xFFFFFFFF, 0xFFFFFFFF,  0x10000}};
ck_assert_int_eq(s21_mul(a, b, &result), 0);
ck_assert_int_eq(s21_is_equal(result, check), 1);

#test mul_by_one_34
s21_decimal a = {{0x12345678, 0xABCDEF, 0x55AA, 0x80000}};
s21_decimal one = {{1, 0, 0, 0}};
s21_decimal result;
ck_assert_int_eq(s21_mul(a, one, &result), 0);
ck_assert(s21_is_equal(a, result));

#test mul_by_minus_one_35
s21_decimal a = {{0x12345678, 0xABCDEF, 0x55AA, 0x80000}};
s21_decimal minus_one = {{1, 0, 0, 0x80000000}};
s21_decimal result;
ck_assert_int_eq(s21_mul(a, minus_one, &result), 0);
ck_assert((result.bits[3] & 0x80000000) != (a.bits[3] & 0x80000000));

#test mul_invalid_scale_36
s21_decimal a = {{5, 0, 0, 0x1D0000}};
s21_decimal b = {{3, 0, 0, 0}};
s21_decimal result;
ck_assert_int_eq(s21_mul(a, b, &result), 4);

#test mul_high_bits_38
s21_decimal a = {{0, 0xFFFFFFFF, 0xFFFFFFFF, 0}};
s21_decimal b = {{2, 0, 0, 0}};
s21_decimal result;
ck_assert_int_eq(s21_mul(a, b, &result), 1);

#test mul_unused_bits_39
s21_decimal a = {{5, 0, 0, 0xFF0000}};
s21_decimal b = {{3, 0, 0, 0}};
s21_decimal result;
ck_assert_int_eq(s21_mul(a, b, &result), 4);

#test mul_precision_loss_40
s21_decimal a = {{123456, 0, 0, 0x1C0000}};
s21_decimal b = {{10, 0, 0, 0x1C0000}};
s21_decimal result;
ck_assert_int_eq(s21_mul(a, b, &result), 2);

#test mul_overflow_sign_41
s21_decimal a = {{0xFFFFFFFF, 0xFFFFFFFF, 0xFFFFFFFF, 0x80000000}};
s21_decimal b = {{2, 0, 0, 0}};
s21_decimal result;
ck_assert_int_eq(s21_mul(a, b, &result), 2);


// ########################################################## s21_negate ##########################################################

#test s21_negate_1

s21_decimal decimal_1, decimal_2, decimal_check;

unsigned int mantissa_1[3] = {0x00000001, 0x00000000, 0x00000000};
set_decimal(&decimal_1, 0x0, 0x0, mantissa_1);
set_decimal(&decimal_check, 0x1, 0x0, mantissa_1);

s21_negate(decimal_1, &decimal_2);

ck_assert_int_eq(get_sign(decimal_2), get_sign(decimal_check)); 


#test s21_negate_2

s21_decimal decimal_1, decimal_2, decimal_check;

unsigned int mantissa_1[3] = {0x00000001, 0x00000000, 0x00000000};
set_decimal(&decimal_1, 0x1, 0x0, mantissa_1);
set_decimal(&decimal_check, 0x0, 0x0, mantissa_1);

s21_negate(decimal_1, &decimal_2);

ck_assert_int_eq(get_sign(decimal_2), get_sign(decimal_check)); 

#test s21_negate_3

s21_decimal decimal_1, decimal_2, decimal_check;

unsigned int mantissa_1[3] = {0x00000001, 0x00000000, 0x00000000};
set_decimal(&decimal_1, 0x1, 0x0, mantissa_1);
set_decimal(&decimal_check, 0x0, 0x0, mantissa_1);
s21_negate(decimal_1, &decimal_2);

ck_assert_int_eq(get_sign(decimal_2), get_sign(decimal_check));

#test s21_negate_4

s21_decimal decimal_1, decimal_2, decimal_check;

unsigned int mantissa_1[3] = {0xFFFFFFFF, 0xFFFFFFFF, 0xFFFFFFFF};
set_decimal(&decimal_1, 0x0, 0x0, mantissa_1);
set_decimal(&decimal_check, 0x1, 0x0, mantissa_1);

s21_negate(decimal_1, &decimal_2);

ck_assert_int_eq(get_sign(decimal_2), get_sign(decimal_check));

#test s21_negate_5

s21_decimal decimal_1, decimal_2, decimal_check;

unsigned int mantissa_1[3] = {0xFFFFFFFF, 0xFFFFFFFF, 0xFFFFFFFF};
set_decimal(&decimal_1, 0x1, 0x0, mantissa_1);
set_decimal(&decimal_check, 0x0, 0x0, mantissa_1);

s21_negate(decimal_1, &decimal_2);

ck_assert_int_eq(get_sign(decimal_2), get_sign(decimal_check));

#test s21_negate_6

s21_decimal decimal_1;
ck_assert_int_eq(s21_negate(decimal_1, NULL), 1);

// ############################################################# DIV #############################################################

#test div_fail_code4_1
// result = NULL
s21_decimal decimal1 = {{0xFFFFFFFF, 0xFFFFFFFF, 0xFFFFFFFF, 0x140000}};
s21_decimal decimal2 = {{0xFFFFFFFF, 0xFFFFFFFF, 0xFFFFFFFF, 0x140000}};
int code = s21_div(decimal1, decimal2, NULL);
ck_assert_int_eq(code, 4);

#test div_fail_code4_2
// degree>28
s21_decimal decimal1 = {{-1, 0, 0, 0x1D0000}};
s21_decimal decimal2 = {{0xFFFFFFFF, 0xFFFFFFFF, 0xFFFFFFFF, 0x140000}};
s21_decimal result;
int code = s21_div(decimal1, decimal2, &result);
ck_assert_int_eq(code, 4);

#test div_fail_code4_3
// not_used_1 != 0
s21_decimal decimal1 = {{-1, 0, 0, 0x1C0001}};
s21_decimal decimal2 = {{0xFFFFFFFF, 0xFFFFFFFF, 0xFFFFFFFF, 0x140000}};
s21_decimal result;
int code = s21_div(decimal1, decimal2, &result);
ck_assert_int_eq(code, 4);

#test div_fail_code4_4
// not_used_2 != 0
s21_decimal decimal1 = {{-1, 0, 0, 0x11C0000}};
s21_decimal decimal2 = {{0xFFFFFFFF, 0xFFFFFFFF, 0xFFFFFFFF, 0x140000}};
s21_decimal result;
int code = s21_div(decimal1, decimal2, &result);
ck_assert_int_eq(code, 4);

#test div_test_ok_5
// 1.2640938749860586450804312205
s21_decimal decimal1 = {{0x1888888D, 0xBE250261, 0x28D856E6, 0x1C0000}};
// 2
s21_decimal decimal2 = {{0x2, 0x0, 0x0, 0x0}};
s21_decimal result;
// 0.6320469374930293225402156102
ck_assert_int_eq(s21_div(decimal1, decimal2, &result), 0);
ck_assert_uint_eq(result.bits[0], 0x8C444446);
ck_assert_uint_eq(result.bits[1], 0x5F128130);
ck_assert_uint_eq(result.bits[2], 0x146C2B73);
ck_assert_uint_eq(result.bits[3], 0x1C0000);

#test div_test_ok_6
// 2
s21_decimal decimal1 = {{0x2, 0x0, 0x0, 0x0}};
// 1.2640938749860586450804312205
s21_decimal decimal2 = {{0x1888888D, 0xBE250261, 0x28D856E6, 0x1C0000}};
s21_decimal result;
ck_assert_int_eq(s21_div(decimal1, decimal2, &result), 0);
// 1.5821609767882606564463392905
ck_assert_uint_eq(result.bits[0], 0x8B80B889);
ck_assert_uint_eq(result.bits[1], 0x20B8279E);
ck_assert_uint_eq(result.bits[2], 0x331F5430);
ck_assert_uint_eq(result.bits[3], 0x1C0000);

#test div_test_ok_7
// 1431655765
s21_decimal decimal1 = {{0x55555555, 0x0, 0x0, 0x0}};
// 12.640938749860586450805
s21_decimal decimal2 = {{0x2EB3EF75, 0x4444026F, 0x2AD, 0x150000}};
s21_decimal result;
// 113255494.17884722765619814067
ck_assert_int_eq(s21_div(decimal1, decimal2, &result), 0);
ck_assert_uint_eq(result.bits[0], 0x6D7C5EB3);
ck_assert_uint_eq(result.bits[1], 0x2C521AF0);
ck_assert_uint_eq(result.bits[2], 0x24984660);
ck_assert_uint_eq(result.bits[3], 0x140000);

#test div_test_ok_8
// 1
s21_decimal decimal1 = {{0x1, 0x0, 0x0, 0x0}};
// 500
s21_decimal decimal2 = {{0x1F4, 0x0, 0x0, 0x0}};
s21_decimal result;
ck_assert_int_eq(s21_div(decimal1, decimal2, &result), 0);
// 0.002
ck_assert_uint_eq(result.bits[0], 0x2);
ck_assert_uint_eq(result.bits[1], 0x0);
ck_assert_uint_eq(result.bits[2], 0x0);
ck_assert_uint_eq(result.bits[3], 0x30000);

#test div_test_ok_9
// 79228162514264337593543950335
s21_decimal decimal1 = {{0xFFFFFFFF, 0xFFFFFFFF, 0xFFFFFFFF, 0x0}};
// 7.9228162514264337593543950335
s21_decimal decimal2 = {{0xFFFFFFFF, 0xFFFFFFFF, 0xFFFFFFFF, 0x1C0000}};
s21_decimal result;
ck_assert_int_eq(s21_div(decimal1, decimal2, &result), 0);
// 10000000000000000000000000000
ck_assert_uint_eq(result.bits[0], 0x10000000);
ck_assert_uint_eq(result.bits[1], 0x3E250261);
ck_assert_uint_eq(result.bits[2], 0x204FCE5E);
ck_assert_uint_eq(result.bits[3], 0x0);

#test div_test_ok_10
// 7.9228162514264337593543950335
s21_decimal decimal1 = {{0xFFFFFFFF, 0xFFFFFFFF, 0xFFFFFFFF, 0x1C0000}};
// 79228162514264337593543950335
s21_decimal decimal2 = {{0xFFFFFFFF, 0xFFFFFFFF, 0xFFFFFFFF, 0x0}};
s21_decimal result;
ck_assert_int_eq(s21_div(decimal1, decimal2, &result), 0);
// 0.0000000000000000000000000001
ck_assert_uint_eq(result.bits[0], 0x1);
ck_assert_uint_eq(result.bits[1], 0x0);
ck_assert_uint_eq(result.bits[2], 0x0);
ck_assert_uint_eq(result.bits[3], 0x1C0000);

#test div_test_ok_11
// 79228162514264337593543950335
s21_decimal decimal1 = {{0xFFFFFFFF, 0xFFFFFFFF, 0xFFFFFFFF, 0x0}};
// -26409387504754779197847983445
s21_decimal decimal2 = {{0x55555555, 0x55555555, 0x55555555, 0x80000000}};
s21_decimal result;
ck_assert_int_eq(s21_div(decimal1, decimal2, &result), 0);
// -3
ck_assert_uint_eq(result.bits[0], 0x3);
ck_assert_uint_eq(result.bits[1], 0x0);
ck_assert_uint_eq(result.bits[2], 0x0);
ck_assert_uint_eq(result.bits[3], 0x80000000);

#test div_test_ok_12
// 79228162514264337593543950335
s21_decimal decimal1 = {{0xFFFFFFFF, 0xFFFFFFFF, 0xFFFFFFFF, 0x0}};
// -26409387504754779197847983445
s21_decimal decimal2 = {{0x55555555, 0x55555555, 0x55555555, 0x80000000}};
s21_decimal result;
ck_assert_int_eq(s21_div(decimal1, decimal2, &result), 0);
// -3
ck_assert_uint_eq(result.bits[0], 0x3);
ck_assert_uint_eq(result.bits[1], 0x0);
ck_assert_uint_eq(result.bits[2], 0x0);
ck_assert_uint_eq(result.bits[3], 0x80000000);

#test div_test_ok_13
