unsigned int mantissa_2[3] = {0x0000000A, 0x00000000, 0x00000000};
set_decimal(&decimal_2, 0x0, 0x0, mantissa_2); // 10.0

ck_assert_int_eq(s21_is_greater(decimal_1, decimal_2), 0); // -10.0 > 10.0 (ложь)

#test s21_is_greater_4
s21_decimal decimal_1, decimal_2;

unsigned int mantissa_1[3] = {0x0000000A, 0x00000000, 0x00000000};
set_decimal(&decimal_1, 0x1, 0x0, mantissa_1); // -10.0

unsigned int mantissa_2[3] = {0x0000000A, 0x00000000, 0x00000000};
set_decimal(&decimal_2, 0x1, 0x0, mantissa_2); // -10.0

ck_assert_int_eq(s21_is_greater(decimal_1, decimal_2), 0); // -10.0 > -10.0 (ложь)

#test s21_is_greater_5
s21_decimal decimal_1, decimal_2;

unsigned int mantissa_1[3] = {0x0000000A, 0x00000000, 0x00000000};
set_decimal(&decimal_1, 0x0, 0x0, mantissa_1); // 10.0

unsigned int mantissa_2[3] = {0x0000000A, 0x00000000, 0x00000000};
