// Тест 1.1: Округление положительного вещественного числа
#test s21_round_real_positive_1

s21_decimal decimal_real_positive = {{0x00003039, 0x00000000, 0x00000000, 0x00020000}}; // 123.45
s21_decimal result;
int error_code_real_positive = s21_round(decimal_real_positive, &result);
ck_assert_int_eq(error_code_real_positive, 0); // Должно возвращать 0 (успех)
ck_assert_int_eq(result.bits[0], 123); // Должно быть 123
ck_assert_int_eq(result.bits[1], 0); // Остальные биты должны быть 0
ck_assert_int_eq(result.bits[2], 0);
ck_assert_int_eq(result.bits[3] & 0x80000000, 0); // Знак должен быть 0


