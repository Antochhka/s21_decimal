ck_assert_int_eq(result_positive.bits[3] & 0x80000000, 0); // Знак должен быть 0


// Тест 2: Отбрасывание дробной части у отрицательного числа
#test s21_truncate_negative

s21_decimal decimal_negative = {{0x00001A85, 0x00000000, 0x00000000, 0x80010000}}; // -678.9
s21_decimal result_negative;
int error_code_negative = s21_truncate(decimal_negative, &result_negative);
ck_assert_int_eq(error_code_negative, 0); // Должно возвращать 0 (успех)
ck_assert_int_eq(result_negative.bits[0], 0x000002A6); // Должно быть 678 (положительное значение)
ck_assert_int_eq(result_negative.bits[1], 0); // Остальные биты должны быть 0
ck_assert_int_eq(result_negative.bits[2], 0);
ck_assert_int_eq(result_negative.bits[3] & 0x80000000, 0x80000000); // Знак должен быть 1


