// Тест 4: Проверка на некорректный указатель
#test s21_from_decimal_to_float_null_pointer

s21_decimal decimal_null = {{0x00003039, 0x00000000, 0x00000000, 0x00010000}}; // 1234.5
int error_code_null = s21_from_decimal_to_float(decimal_null, NULL);
ck_assert_int_eq(error_code_null, 1); // Должно возвращать 1 (ошибка из-за NULL указателя)


// Тест 5.1: Преобразование очень большого положительного Decimal в float
#test s21_from_decimal_to_float_large_value_1

s21_decimal decimal_large = {{0xFFFFFFFF, 0xFFFFFFFF, 0xFFFFFFFF, 0x00000000}}; // 79228162514264337593543950335
float result_large;
int error_code_large = s21_from_decimal_to_float(decimal_large, &result_large);
ck_assert_int_eq(error_code_large, 0); // Должно возвращать 0 (успех)
// Ожидаемое значение: 2^96 - 1 (максимальное значение)
ck_assert_float_eq(result_large, 79228162514264337593543950335.0f); // Должно быть максимально возможное значение


// Тест 5.2: Преобразование очень большого отрицательного Decimal в float
#test s21_from_decimal_to_float_large_value_2

s21_decimal decimal_large = {{0xFFFFFFFF, 0xFFFFFFFF, 0xFFFFFFFF, 0x80000000}}; // -79228162514264337593543950335
float result_large;
int error_code_large = s21_from_decimal_to_float(decimal_large, &result_large);
ck_assert_int_eq(error_code_large, 0); // Должно возвращать 0 (успех)
// Ожидаемое значение: -(2^96 - 1) (минимальное значение)
ck_assert_float_eq(result_large, -79228162514264337593543950335.0f); // Должно быть отрицательное максимально возможное значение


// Тест 6.1: Преобразование очень маленького положительного Decimal в float
#test s21_from_decimal_to_float_small_value_1

s21_decimal decimal_small = {{0x00000001, 0x00000000, 0x00000000, 0x001C0000}}; // 1e-28
float result_small;
int error_code_small = s21_from_decimal_to_float(decimal_small, &result_small);
ck_assert_int_eq(error_code_small, 0); // Должно возвращать 0 (успех)
ck_assert_float_eq(result_small, 1e-28f); // Должно быть минимально возможное значение


// Тест 6.2: Преобразование очень маленького отрицательного Decimal в float
#test s21_from_decimal_to_float_small_value_2

s21_decimal decimal_small = {{0x00000001, 0x00000000, 0x00000000, 0x801C0000}}; // -(1e-28)
float result_small;
int error_code_small = s21_from_decimal_to_float(decimal_small, &result_small);
ck_assert_int_eq(error_code_small, 0); // Должно возвращать 0 (успех)
ck_assert_float_eq(result_small, -1e-28f); // Должно быть отрицательное минимально возможное значение


// ################################################ s21_truncate ################################################

// Тест 1.1: Отбрасывание дробной части у положительного числа
#test s21_truncate_positive_1

s21_decimal decimal_positive = {{0x00003039, 0x00000000, 0x00000000, 0x00010000}}; // 1234.5
s21_decimal result_positive;
int error_code_positive = s21_truncate(decimal_positive, &result_positive);
ck_assert_int_eq(error_code_positive, 0); // Должно возвращать 0 (успех)
ck_assert_int_eq(result_positive.bits[0], 0x000004D2); // Должно быть 1234
ck_assert_int_eq(result_positive.bits[1], 0); // Остальные биты должны быть 0
ck_assert_int_eq(result_positive.bits[2], 0);
ck_assert_int_eq(result_positive.bits[3] & 0x80000000, 0); // Знак должен быть 0


// Тест 1.2: Отбрасывание дробной части у положительного числа
#test s21_truncate_positive_2

s21_decimal decimal_positive = {{0x00003039, 0x00000000, 0x00000000, 0x00020000}}; // 123.45
s21_decimal result_positive;
int error_code_positive = s21_truncate(decimal_positive, &result_positive);
ck_assert_int_eq(error_code_positive, 0); // Должно возвращать 0 (успех)
ck_assert_int_eq(result_positive.bits[0], 0x0000007B); // Должно быть 123
ck_assert_int_eq(result_positive.bits[1], 0); // Остальные биты должны быть 0
ck_assert_int_eq(result_positive.bits[2], 0);
ck_assert_int_eq(result_positive.bits[3] & 0x80000000, 0); // Знак должен быть 0


// Тест 1.3: Отбрасывание дробной части у положительного числа
#test s21_truncate_positive_3

s21_decimal decimal_positive = {{0x00003039, 0x00000000, 0x00000000, 0x00040000}}; // 1.2345
s21_decimal result_positive;
int error_code_positive = s21_truncate(decimal_positive, &result_positive);
ck_assert_int_eq(error_code_positive, 0); // Должно возвращать 0 (успех)
ck_assert_int_eq(result_positive.bits[0], 0x00000001); // Должно быть 1
ck_assert_int_eq(result_positive.bits[1], 0); // Остальные биты должны быть 0
ck_assert_int_eq(result_positive.bits[2], 0);
ck_assert_int_eq(result_positive.bits[3] & 0x80000000, 0); // Знак должен быть 0


