#include "./s21_decimal.h"

// ############################################################## LEFT_SHIFT ##############################################################


#test left_shift_1
s21_decimal decimal_1;
unsigned int mantissa_1[3] = {0x1, 0x0, 0x0};
set_decimal(&decimal_1, 0x0, 0x1, mantissa_1);
left_shift(&decimal_1, 32);
unsigned int correct_value[3] = {0x0, 0x1, 0x0};
for (int i = 0; i < 3; i++) {
    ck_assert_uint_eq(decimal_1.bits[i], correct_value[i]);
}

#test left_shift_2
s21_decimal decimal_1;
unsigned int mantissa_1[3] = {0x80000000, 0x0, 0x0}; // В старшем бите первого числа есть 1, чтобы проверить перенос
set_decimal(&decimal_1, 0x0, 0x1, mantissa_1);
left_shift(&decimal_1, 1);
unsigned int correct_value[3] = {0x0, 0x1, 0x0}; // После смещения все биты сдвигаются, перенос во вторую часть
for (int i = 0; i < 3; i++) {
    ck_assert_uint_eq(decimal_1.bits[i], correct_value[i]);
}

#test left_shift_3
s21_decimal decimal_1;
unsigned int mantissa_1[3] = {0xFFFFFFFF, 0xFFFFFFFF, 0xFFFFFFFF}; // Все биты установлены
set_decimal(&decimal_1, 0x0, 0x1, mantissa_1);
left_shift(&decimal_1, 96);
unsigned int correct_value[3] = {0x0, 0x0, 0x0}; // Смещение на 96 бит обнуляет все числа
for (int i = 0; i < 3; i++) {
    ck_assert_uint_eq(decimal_1.bits[i], correct_value[i]);
}

#test left_shift_4
s21_decimal decimal_1;
unsigned int mantissa_1[3] = {0xAABBCCDD, 0x11223344, 0x55667788};
set_decimal(&decimal_1, 0x0, 0x1, mantissa_1);
left_shift(&decimal_1, 0);
unsigned int correct_value[3] = {0xAABBCCDD, 0x11223344, 0x55667788}; // Нет изменений
for (int i = 0; i < 3; i++) {
    ck_assert_uint_eq(decimal_1.bits[i], correct_value[i]);
}

#test left_shift_5
s21_decimal decimal_1;
unsigned int mantissa_1[3] = {0xFFFFFFFF, 0x00000000, 0x00000000}; // Установлены все биты в младшем числе
set_decimal(&decimal_1, 0x0, 0x1, mantissa_1);
left_shift(&decimal_1, 1);
unsigned int correct_value[3] = {0xFFFFFFFE, 0x00000001, 0x00000000}; // Переполнение в следующий разряд
for (int i = 0; i < 3; i++) {
    ck_assert_uint_eq(decimal_1.bits[i], correct_value[i]);
}

// ############################################################# NORMALIZATION #############################################################

#test normalization_test_1
s21_decimal decimal_1, decimal_2;

// Задаем значение для первого числа: меньшая степень
unsigned int mantissa_1[3] = {0x00000001, 0x00000000, 0x00000000};
set_decimal(&decimal_1, 0x0, 0x0, mantissa_1); // степень: 0

unsigned int mantissa_2[3] = {0x00000001, 0x00000000, 0x00000000};
set_decimal(&decimal_2, 0x0, 0x3, mantissa_2); // степень: 3

// Ожидаемое значение после нормализации: decimal_1 должен быть умножен на 10^3
unsigned int expected_mantissa_1[3] = {0x000003E8, 0x00000000, 0x00000000}; // 1000
unsigned int expected_mantissa_2[3] = {0x00000001, 0x00000000, 0x00000000}; // без изменений

// Вызываем функцию нормализации
normalization(&decimal_1, &decimal_2);

// Проверяем, что decimal_1 был скорректирован
for (int i = 0; i < 3; i++) {
    ck_assert_uint_eq(decimal_1.bits[i], expected_mantissa_1[i]);
}

// Проверяем, что decimal_2 остался неизменным
for (int i = 0; i < 3; i++) {
    ck_assert_uint_eq(decimal_2.bits[i], expected_mantissa_2[i]);
}

// Проверяем, что степени теперь совпадают
int degree_1 = get_degree(decimal_1);
int degree_2 = get_degree(decimal_2);
ck_assert_int_eq(degree_1, degree_2);

#test normalization_test_2
s21_decimal decimal_1, decimal_2;

// Задаем одинаковые степени
unsigned int mantissa_1[3] = {0x12345678, 0x9ABCDEF0, 0x00000000};
set_decimal(&decimal_1, 0x0, 0x2, mantissa_1);

unsigned int mantissa_2[3] = {0x87654321, 0x0FEDCBA9, 0x00000000};
set_decimal(&decimal_2, 0x0, 0x2, mantissa_2);

// Вызываем функцию нормализации
normalization(&decimal_1, &decimal_2);

// Проверяем, что числа остались неизменными
for (int i = 0; i < 3; i++) {
    ck_assert_uint_eq(decimal_1.bits[i], mantissa_1[i]);
    ck_assert_uint_eq(decimal_2.bits[i], mantissa_2[i]);
}

// Проверяем, что степени совпадают
int degree_1 = get_degree(decimal_1);
int degree_2 = get_degree(decimal_2);
ck_assert_int_eq(degree_1, degree_2);

#test normalization_test_small_degree_diff
s21_decimal decimal_1, decimal_2;

// Один из примеров с малой разницей в степенях: degree_1 = 1, degree_2 = 2
unsigned int mantissa_1[3] = {0x0000000A, 0x00000000, 0x00000000}; // 10
set_decimal(&decimal_1, 0x0, 0x1, mantissa_1); // степень = 1

unsigned int mantissa_2[3] = {0x00000001, 0x00000000, 0x00000000}; // 1
set_decimal(&decimal_2, 0x0, 0x2, mantissa_2); // степень = 2

// Ожидаемое значение; decimal_1 должен быть умножен на 10 
unsigned int expected_mantissa_1[3] = {0x00000064, 0x00000000, 0x00000000}; // 100

// Вызываем нормализацию
normalization(&decimal_1, &decimal_2);

// Проверка результата
for (int i = 0; i < 3; i++) {
    ck_assert_uint_eq(decimal_1.bits[i], expected_mantissa_1[i]);
}

// Проверяем степень
int degree_1 = get_degree(decimal_1);
int degree_2 = get_degree(decimal_2);
ck_assert_int_eq(degree_1, degree_2);

#test normalization_test_equal_degrees
s21_decimal decimal_1, decimal_2;

// Оба числа уже имеют одинаковую степень
unsigned int mantissa_1[3] = {0x0000000A, 0x00000000, 0x00000000}; // 10
set_decimal(&decimal_1, 0x0, 0x2, mantissa_1); // степень = 2

unsigned int mantissa_2[3] = {0x00000014, 0x00000000, 0x00000000}; // 20
set_decimal(&decimal_2, 0x0, 0x2, mantissa_2); // степень = 2

// Ожидаемое значение (числа не должны измениться)
unsigned int expected_mantissa_1[3] = {0x0000000A, 0x00000000, 0x00000000}; // 10
unsigned int expected_mantissa_2[3] = {0x00000014, 0x00000000, 0x00000000}; // 20

// Вызываем нормализацию
normalization(&decimal_1, &decimal_2);

// Проверка результата
for (int i = 0; i < 3; i++) {
    ck_assert_uint_eq(decimal_1.bits[i], expected_mantissa_1[i]);
    ck_assert_uint_eq(decimal_2.bits[i], expected_mantissa_2[i]);
}

// Проверяем степень
int degree_1 = get_degree(decimal_1);
int degree_2 = get_degree(decimal_2);
ck_assert_int_eq(degree_1, degree_2);

#test normalization_test_large_degree_diff
s21_decimal decimal_1, decimal_2;

// Большая разница степеней: degree_1 = 1, degree_2 = 5
unsigned int mantissa_1[3] = {0x00000064, 0x00000000, 0x00000000}; // 100
set_decimal(&decimal_1, 0x0, 0x1, mantissa_1); // степень = 1

unsigned int mantissa_2[3] = {0x00000001, 0x00000000, 0x00000000}; // 1
set_decimal(&decimal_2, 0x0, 0x5, mantissa_2); // степень = 5

// Ожидаемое значение (decimal_1 должен быть умножен на 10^4)
unsigned int expected_mantissa_1[3] = {0x000F4240, 0x00000000, 0x00000000}; // 1000000

// Вызываем нормализацию
normalization(&decimal_1, &decimal_2);

// Проверка результата
for (int i = 0; i < 3; i++) {
    ck_assert_uint_eq(decimal_1.bits[i], expected_mantissa_1[i]);
}

// Проверяем степень
int degree_1 = get_degree(decimal_1);
int degree_2 = get_degree(decimal_2);
ck_assert_int_eq(degree_1, degree_2);

// ######################################################## s21_is_equal #########################################################

#test s21_is_equal_1

s21_decimal decimal_1, decimal_2;

unsigned int mantissa_1[3] = {0x00000001, 0x00000000, 0x00000000};
set_decimal(&decimal_1, 0x0, 0x0, mantissa_1);

unsigned int mantissa_2[3] = {0x00000001, 0x00000000, 0x00000000};
set_decimal(&decimal_2, 0x0, 0x0, mantissa_2); 

ck_assert_int_eq(s21_is_equal(decimal_1, decimal_2), 1);

#test s21_is_equal_2

s21_decimal decimal_1, decimal_2;

unsigned int mantissa_1[3] = {0x00000001, 0x00000000, 0x00000000};
set_decimal(&decimal_1, 0x1, 0x0, mantissa_1); // 

unsigned int mantissa_2[3] = {0x00000001, 0x00000000, 0x00000000};
set_decimal(&decimal_2, 0x0, 0x0, mantissa_2); 

ck_assert_int_eq(s21_is_equal(decimal_1, decimal_2), 0);

#test s21_is_equal_negative_case

s21_decimal decimal_1, decimal_2;

unsigned int mantissa_1[3] = {0x00000001, 0x00000000, 0x00000000};
set_decimal(&decimal_1, 0x0, 0x0, mantissa_1);

unsigned int mantissa_2[3] = {0x00000002, 0x00000000, 0x00000000};
set_decimal(&decimal_2, 0x0, 0x0, mantissa_2);

ck_assert_int_eq(s21_is_equal(decimal_1, decimal_2), 0);

#test s21_is_equal_negative_and_positive

s21_decimal decimal_1, decimal_2;

unsigned int mantissa_1[3] = {0x00000001, 0x00000000, 0x00000000};
set_decimal(&decimal_1, 0x1, 0x0, mantissa_1); // знак минус

unsigned int mantissa_2[3] = {0x00000001, 0x00000000, 0x00000000};
set_decimal(&decimal_2, 0x0, 0x0, mantissa_2); // знак плюс

ck_assert_int_eq(s21_is_equal(decimal_1, decimal_2), 0);

#test s21_is_equal_with_exponent

s21_decimal decimal_1, decimal_2;

unsigned int mantissa_1[3] = {0x00000001, 0x00000000, 0x00000000};
set_decimal(&decimal_1, 0x0, 0x2, mantissa_1); // exponent = 2 (1 * 10^-2)

unsigned int mantissa_2[3] = {0x00000064, 0x00000000, 0x00000000};
set_decimal(&decimal_2, 0x0, 0x0, mantissa_2); // 100

ck_assert_int_eq(s21_is_equal(decimal_1, decimal_2), 0); // 0.01 == 100 * 10^-2

#test s21_is_equal_with_large_numbers

s21_decimal decimal_1, decimal_2;

unsigned int mantissa_1[3] = {0xFFFFFFFF, 0xFFFFFFFF, 0xFFFFFFFF};
set_decimal(&decimal_1, 0x0, 0x0, mantissa_1); 

unsigned int mantissa_2[3] = {0xFFFFFFFF, 0xFFFFFFFF, 0xFFFFFFFF};
set_decimal(&decimal_2, 0x0, 0x0, mantissa_2);

ck_assert_int_eq(s21_is_equal(decimal_1, decimal_2), 1); // оба числа равны

#test s21_is_equal_zero_and_positive_number

s21_decimal decimal_1, decimal_2;

unsigned int mantissa_1[3] = {0x00000000, 0x00000000, 0x00000000};
set_decimal(&decimal_1, 0x0, 0x0, mantissa_1); // 0

unsigned int mantissa_2[3] = {0x00000001, 0x00000000, 0x00000000};
set_decimal(&decimal_2, 0x0, 0x0, mantissa_2); // 1

ck_assert_int_eq(s21_is_equal(decimal_1, decimal_2), 0);

#test s21_is_equal_negative_numbers

s21_decimal decimal_1, decimal_2;

unsigned int mantissa_1[3] = {0x00000005, 0x00000000, 0x00000000};
set_decimal(&decimal_1, 0x1, 0x0, mantissa_1); // -5

unsigned int mantissa_2[3] = {0x00000005, 0x00000000, 0x00000000};
set_decimal(&decimal_2, 0x1, 0x0, mantissa_2); // -5

ck_assert_int_eq(s21_is_equal(decimal_1, decimal_2), 1); // -5 == -5

// ####################################################### s21_is_not_equal ######################################################

#test s21_is_not_equal_1

s21_decimal decimal_1, decimal_2;

unsigned int mantissa_1[3] = {0x00000001, 0x00000000, 0x00000000};
set_decimal(&decimal_1, 0x0, 0x0, mantissa_1);

unsigned int mantissa_2[3] = {0x00000001, 0x00000000, 0x00000000};
set_decimal(&decimal_2, 0x0, 0x0, mantissa_2); 

ck_assert_int_eq(s21_is_not_equal(decimal_1, decimal_2), 0);

#test s21_is_not_equal_2

s21_decimal decimal_1, decimal_2;

unsigned int mantissa_1[3] = {0x00000001, 0x00000000, 0x00000000};
set_decimal(&decimal_1, 0x1, 0x0, mantissa_1); // 

unsigned int mantissa_2[3] = {0x00000001, 0x00000000, 0x00000000};
set_decimal(&decimal_2, 0x0, 0x0, mantissa_2); 

ck_assert_int_eq(s21_is_not_equal(decimal_1, decimal_2), 1);

#test s21_is_not_equal_negative_case

s21_decimal decimal_1, decimal_2;

unsigned int mantissa_1[3] = {0x00000001, 0x00000000, 0x00000000};
set_decimal(&decimal_1, 0x0, 0x0, mantissa_1);

unsigned int mantissa_2[3] = {0x00000002, 0x00000000, 0x00000000};
set_decimal(&decimal_2, 0x0, 0x0, mantissa_2);

ck_assert_int_eq(s21_is_not_equal(decimal_1, decimal_2), 1);

#test s21_is_not_equal_negative_and_positive

s21_decimal decimal_1, decimal_2;

unsigned int mantissa_1[3] = {0x00000001, 0x00000000, 0x00000000};
set_decimal(&decimal_1, 0x1, 0x0, mantissa_1); // знак минус

unsigned int mantissa_2[3] = {0x00000001, 0x00000000, 0x00000000};
set_decimal(&decimal_2, 0x0, 0x0, mantissa_2); // знак плюс

ck_assert_int_eq(s21_is_not_equal(decimal_1, decimal_2), 1);

#test s21_is_not_equal_with_exponent

s21_decimal decimal_1, decimal_2;

unsigned int mantissa_1[3] = {0x00000001, 0x00000000, 0x00000000};
set_decimal(&decimal_1, 0x0, 0x2, mantissa_1); // exponent = 2 (1 * 10^-2)

unsigned int mantissa_2[3] = {0x00000064, 0x00000000, 0x00000000};
set_decimal(&decimal_2, 0x0, 0x0, mantissa_2); // 100

ck_assert_int_eq(s21_is_not_equal(decimal_1, decimal_2), 1); // 0.01 == 100 * 10^-2

#test s21_is_not_equal_with_large_numbers

s21_decimal decimal_1, decimal_2;

unsigned int mantissa_1[3] = {0xFFFFFFFF, 0xFFFFFFFF, 0xFFFFFFFF};
set_decimal(&decimal_1, 0x0, 0x0, mantissa_1); 

unsigned int mantissa_2[3] = {0xFFFFFFFF, 0xFFFFFFFF, 0xFFFFFFFF};
set_decimal(&decimal_2, 0x0, 0x0, mantissa_2);

ck_assert_int_eq(s21_is_not_equal(decimal_1, decimal_2), 0); // оба числа равны

#test s21_is_not_equal_zero_and_positive_number

s21_decimal decimal_1, decimal_2;

unsigned int mantissa_1[3] = {0x00000000, 0x00000000, 0x00000000};
set_decimal(&decimal_1, 0x0, 0x0, mantissa_1); // 0

unsigned int mantissa_2[3] = {0x00000001, 0x00000000, 0x00000000};
set_decimal(&decimal_2, 0x0, 0x0, mantissa_2); // 1

ck_assert_int_eq(s21_is_not_equal(decimal_1, decimal_2), 1);

#test s21_is_not_equal_negative_numbers

s21_decimal decimal_1, decimal_2;

unsigned int mantissa_1[3] = {0x00000005, 0x00000000, 0x00000000};
set_decimal(&decimal_1, 0x1, 0x0, mantissa_1); // -5

unsigned int mantissa_2[3] = {0x00000005, 0x00000000, 0x00000000};
set_decimal(&decimal_2, 0x1, 0x0, mantissa_2); // -5

ck_assert_int_eq(s21_is_not_equal(decimal_1, decimal_2), 0); // -5 == -5

// ######################################################### s21_is_less #########################################################

#test s21_is_less_1

s21_decimal decimal_1, decimal_2;

unsigned int mantissa_1[3] = {0x00000001, 0x00000000, 0x00000000};
set_decimal(&decimal_1, 0x1, 0x0, mantissa_1);

unsigned int mantissa_2[3] = {0x00000001, 0x00000000, 0x00000000};
set_decimal(&decimal_2, 0x0, 0x0, mantissa_2);

ck_assert_int_eq(s21_is_less(decimal_1, decimal_2), 1);

#test s21_is_less_2

s21_decimal decimal_1, decimal_2;

unsigned int mantissa_1[3] = {0x0000000A, 0x00000000, 0x00000000};
set_decimal(&decimal_1, 0x0, 0x0, mantissa_1);

unsigned int mantissa_2[3] = {0x00000001, 0x00000000, 0x00000000};
set_decimal(&decimal_2, 0x0, 0x0, mantissa_2);

ck_assert_int_eq(s21_is_less(decimal_1, decimal_2), 0);

