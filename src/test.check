// ################################################ s21_from_decimal_to_int ################################################

// Тест 1.1: Преобразование положительного десятичного числа в целое
#test s21_from_decimal_to_int_positive_1

s21_decimal decimal_1 = {{0x00000001, 0x00000000, 0x00000000, 0x00000000}}; // 1.0
int result_pos = 0;
int error_code_pos = s21_from_decimal_to_int(decimal_1, &result_pos);
ck_assert_int_eq(error_code_pos, 0);
ck_assert_int_eq(result_pos, 1);


// Тест 1.2: Преобразование положительного десятичного числа в целое
#test s21_from_decimal_to_int_positive_2

s21_decimal decimal_1 = {{0x00003039, 0x00000000, 0x00000000, 0x00000000}}; // 12345.0
int result_pos = 0;
int error_code_pos = s21_from_decimal_to_int(decimal_1, &result_pos);
ck_assert_int_eq(error_code_pos, 0);
ck_assert_int_eq(result_pos, 12345);


// Тест 2.1: Преобразование отрицательного десятичного числа в целое
#test s21_from_decimal_to_int_negative_1

s21_decimal decimal_2 = {{0x00000001, 0x00000000, 0x00000000, 0x80000000}}; // -1.0
int result_neg = 0;
int error_code_neg = s21_from_decimal_to_int(decimal_2, &result_neg);
ck_assert_int_eq(error_code_neg, 0);
ck_assert_int_eq(result_neg, -1);


// Тест 2.2: Преобразование отрицательного десятичного числа в целое
#test s21_from_decimal_to_int_negative_2

s21_decimal decimal_2 = {{0x0000D431, 0x00000000, 0x00000000, 0x80000000}}; // -54321.0
int result_neg = 0;
int error_code_neg = s21_from_decimal_to_int(decimal_2, &result_neg);
ck_assert_int_eq(error_code_neg, 0);
ck_assert_int_eq(result_neg, -54321);


// Тест 3.1: Преобразование десятичного числа с дробной частью
#test s21_from_decimal_to_int_fractional_1

s21_decimal decimal_3 = {{0x00000019, 0x00000000, 0x00000000, 0x00010000}}; // 2.5 (25/10^1)
int result_frac = 0;
int error_code_frac = s21_from_decimal_to_int(decimal_3, &result_frac);
ck_assert_int_eq(error_code_frac, 0);
ck_assert_int_eq(result_frac, 2); // Должно округляться до 2


// Тест 3.2: Преобразование десятичного числа с дробной частью
#test s21_from_decimal_to_int_fractional_2

s21_decimal decimal_3 = {{0x00000019, 0x00000000, 0x00000000, 0x80010000}}; // -2.5 (-(25/10^1))
int result_frac = 0;
int error_code_frac = s21_from_decimal_to_int(decimal_3, &result_frac);
ck_assert_int_eq(error_code_frac, 0);
ck_assert_int_eq(result_frac, -2); // Должно округляться до -2


// Тест 3.3: Преобразование десятичного числа с дробной частью
#test s21_from_decimal_to_int_fractional_3

s21_decimal decimal_3 = {{0x00084993, 0x00000000, 0x00000000, 0x00030000}}; // 543.123 (543123/10^3)
int result_frac = 0;
int error_code_frac = s21_from_decimal_to_int(decimal_3, &result_frac);
ck_assert_int_eq(error_code_frac, 0);
ck_assert_int_eq(result_frac, 543); // Должно округляться до 543


// Тест 4: Преобразование нулевого десятичного числа в целое
#test s21_from_decimal_to_int_zero

s21_decimal decimal_4 = {{0x00000000, 0x00000000, 0x00000000, 0x00000000}}; // 0.0
int result_zero = 0;
int error_code_zero = s21_from_decimal_to_int(decimal_4, &result_zero);
ck_assert_int_eq(error_code_zero, 0);
ck_assert_int_eq(result_zero, 0); // Должно быть 0


// Тест 5: Преобразование слишком большого десятичного числа
#test s21_from_decimal_to_int_too_large

s21_decimal decimal_5 = {{0xFFFFFFFF, 0xFFFFFFFF, 0xFFFFFFFF, 0x00000000}}; // Очень большое число
int result_large = 0;
int error_code_large = s21_from_decimal_to_int(decimal_5, &result_large);
ck_assert_int_eq(error_code_large, 1); // Должно возвращать ошибку, переполнение
ck_assert_int_eq(result_large, 0); // Должно не меняться относительного начального значения


// Тест 6: Неверный указатель (обработка)
#test s21_from_decimal_to_int_null_pointer

s21_decimal decimal_6; // Неинициализированная переменная
int error_code_null = s21_from_decimal_to_int(decimal_6, NULL);
ck_assert_int_eq(error_code_null, 1); // Должно возвращать ошибку для null указателя


// Тест 7: Некорректная степень
#test s21_from_decimal_to_int_incorrect_scale

s21_decimal decimal_7 = {{1, 0, 0, 0x1D0000}};
int result_incorrect_scale = 0;
int error_code_incorrect_scale = s21_from_decimal_to_int(decimal_7, &result_incorrect_scale);
ck_assert_int_eq(error_code_incorrect_scale, 1);
ck_assert_int_eq(result_incorrect_scale, 0);


// ################################################ s21_from_int_to_decimal ################################################

// Тест 1: Преобразование положительного целого числа
#test s21_from_int_to_decimal_positive

s21_decimal decimal_positive;
int error_code_positive = s21_from_int_to_decimal(12345, &decimal_positive);
ck_assert_int_eq(error_code_positive, 0); // Должно возвращать 0 (успех)
ck_assert_int_eq(decimal_positive.bits[0], 12345); // Должно быть 12345
ck_assert_int_eq(decimal_positive.bits[1], 0); // Остальные биты должны быть 0
ck_assert_int_eq(decimal_positive.bits[2], 0);
ck_assert_int_eq(decimal_positive.bits[3] & 0x80000000, 0); // Знак должен быть 0


// Тест 2: Преобразование отрицательного целого числа
#test s21_from_int_to_decimal_negative

s21_decimal decimal_negative;
int error_code_negative = s21_from_int_to_decimal(-6789, &decimal_negative);
ck_assert_int_eq(error_code_negative, 0); // Должно возвращать 0 (успех)
ck_assert_int_eq(decimal_negative.bits[0], 6789); // Должно быть 6789 (положительное значение)
ck_assert_int_eq(decimal_negative.bits[1], 0); // Остальные биты должны быть 0
ck_assert_int_eq(decimal_negative.bits[2], 0);
ck_assert_int_eq(decimal_negative.bits[3] & 0x80000000, 0x80000000); // Знак должен быть 1


// Тест 3: Преобразование нулевого целого числа
#test s21_from_int_to_decimal_zero

s21_decimal decimal_zero;
int error_code_zero = s21_from_int_to_decimal(0, &decimal_zero);
ck_assert_int_eq(error_code_zero, 0); // Должно возвращать 0 (успех)
ck_assert_int_eq(decimal_zero.bits[0], 0); // Должно быть 0
ck_assert_int_eq(decimal_zero.bits[1], 0); // Остальные биты должны быть 0
ck_assert_int_eq(decimal_zero.bits[2], 0);
ck_assert_int_eq(decimal_zero.bits[3] & 0x80000000, 0); // Знак должен быть 0


// Тест 4: Некорректный указатель на s21_decimal
#test s21_from_int_to_decimal_null_pointer

int error_code_null = s21_from_int_to_decimal(123, NULL);
ck_assert_int_eq(error_code_null, 1); // Должно возвращать 1 (ошибка, указатель NULL)


// Тест 5: Преобразование большого положительного числа
#test s21_from_int_to_decimal_large_positive

s21_decimal decimal_large_positive;
int error_code_large_positive = s21_from_int_to_decimal(2147483647, &decimal_large_positive); // Максимальное значение int
ck_assert_int_eq(error_code_large_positive, 0); // Должно возвращать 0 (успех)
ck_assert_int_eq(decimal_large_positive.bits[0], 2147483647); // Должно быть 2147483647
ck_assert_int_eq(decimal_large_positive.bits[1], 0); // Остальные биты должны быть 0
ck_assert_int_eq(decimal_large_positive.bits[2], 0);
ck_assert_int_eq(decimal_large_positive.bits[3] & 0x80000000, 0); // Знак должен быть 0


// Тест 6: Преобразование большого отрицательного числа
#test s21_from_int_to_decimal_large_negative

s21_decimal decimal_large_negative;
int error_code_large_negative = s21_from_int_to_decimal(-2147483647, &decimal_large_negative); // Максимальное отрицательное значение int
ck_assert_int_eq(error_code_large_negative, 0); // Должно возвращать 0 (успех)
ck_assert_int_eq(decimal_large_negative.bits[0], 2147483647); // Должно быть 2147483647 (положительное значение)
ck_assert_int_eq(decimal_large_negative.bits[1], 0); // Остальные биты должны быть 0
ck_assert_int_eq(decimal_large_negative.bits[2], 0);
ck_assert_int_eq(decimal_large_negative.bits[3] & 0x80000000, 0x80000000); // Знак должен быть 1


// ################################################ s21_from_decimal_to_float ################################################

// Тест 1.1: Преобразование положительного Decimal в float
#test s21_from_decimal_to_float_positive_1

s21_decimal decimal_positive = {{0x00003039, 0x00000000, 0x00000000, 0x00010000}}; // 1234.5 
float result_positive;
int error_code_positive = s21_from_decimal_to_float(decimal_positive, &result_positive);
ck_assert_int_eq(error_code_positive, 0); // Должно возвращать 0 (успех)
ck_assert_float_eq(result_positive, 1234.5f); // Должно быть 1234.5


// Тест 1.2: Преобразование положительного Decimal в float
#test s21_from_decimal_to_float_positive_2

s21_decimal decimal_positive = {{0x00003039, 0x00000000, 0x00000000, 0x00030000}}; // 12.345 
float result_positive;
int error_code_positive = s21_from_decimal_to_float(decimal_positive, &result_positive);
ck_assert_int_eq(error_code_positive, 0); // Должно возвращать 0 (успех)
ck_assert_float_eq(result_positive, 12.345f); // Должно быть 12.345


// Тест 1.3: Преобразование положительного Decimal в float
#test s21_from_decimal_to_float_positive_3

s21_decimal decimal_positive = {{0x00003039, 0x00000000, 0x00000000, 0x00050000}}; // 0.12345 
float result_positive;
int error_code_positive = s21_from_decimal_to_float(decimal_positive, &result_positive);
ck_assert_int_eq(error_code_positive, 0); // Должно возвращать 0 (успех)
ck_assert_float_eq(result_positive, 0.12345f); // Должно быть 0.12345


// Тест 2: Преобразование отрицательного Decimal в float
#test s21_from_decimal_to_float_negative

s21_decimal decimal_negative = {{0x00003039, 0x00000000, 0x00000000, 0x80010000}}; // -1234.5 
float result_negative;
int error_code_negative = s21_from_decimal_to_float(decimal_negative, &result_negative);
ck_assert_int_eq(error_code_negative, 0); // Должно возвращать 0 (успех)
ck_assert_float_eq(result_negative, -1234.5f); // Должно быть -1234.5


// Тест 3.1: Преобразование нуля Decimal в float
